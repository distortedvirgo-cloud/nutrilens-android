<?xml version="1.0" encoding="utf-8"?>
<!-- Светлая тема. Корень прозрачный: лаунчер может отдать виджету больше
     места, чем 1 ряд (старый инстанс после обновления приложения сохраняет
     прежний размер), поэтому «капсула» всегда центрируется. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Капсула-каркас: FrameLayout, чтобы единственный ребёнок (контент)
         центрировался и горизонтально, и вертикально. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:background="@drawable/widget_bg"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Кольцо с числом остатка внутри (как в референсе). -->
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="6dp">

                <ImageView
                    android:id="@+id/widget_ring"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_remain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeMaxTextSize="14sp"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="2100"
                        android:textColor="#0F172A"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/widget_remain_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="ккал"
                        android:textColor="#64748B"
                        android:textSize="7sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Разделитель: RemoteViews не умеет голый <View>, поэтому FrameLayout. -->
            <FrameLayout
                android:layout_width="1.5dp"
                android:layout_height="34dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:background="#E1F2ED" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_dot_p"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/widget_dot_protein" />

                    <TextView
                        android:id="@+id/widget_p"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-black"
                        android:maxLines="1"
                        android:text="0"
                        android:textColor="#0F172A"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:text="Б"
                        android:textColor="#64748B"
                        android:textSize="8sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_dot_f"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/widget_dot_fat" />

                    <TextView
                        android:id="@+id/widget_f"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-black"
                        android:maxLines="1"
                        android:text="0"
                        android:textColor="#0F172A"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:text="Ж"
                        android:textColor="#64748B"
                        android:textSize="8sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_dot_c"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/widget_dot_carbs" />

                    <TextView
                        android:id="@+id/widget_c"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-black"
                        android:maxLines="1"
                        android:text="0"
                        android:textColor="#0F172A"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:text="У"
                        android:textColor="#64748B"
                        android:textSize="8sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
